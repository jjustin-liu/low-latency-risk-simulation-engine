# RiskSim web frontend — environment configuration
# Copy to `.env.local` and fill in.

# WebSocket URL of the RiskSim bridge. Client-visible (NEXT_PUBLIC_).
# Defaults to ws://localhost:8080 when unset.
NEXT_PUBLIC_BRIDGE_URL=ws://localhost:8080

# Anthropic API key for the /api/shock natural-language console.
# SERVER-ONLY — never exposed to the browser. If unset (or the API call
# fails), /api/shock transparently falls back to a deterministic offline
# keyword parser, so the demo still works without a key.
ANTHROPIC_API_KEY=
