# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# Next.js frontend. Multi-stage: install + build, then a slim runtime that
# runs `next start`. In production the frontend is deployed to Vercel (see
# deploy/README.md); this image exists for the local all-in-one compose stack.
#
# NEXT_PUBLIC_BRIDGE_URL is baked at build time (Next.js inlines NEXT_PUBLIC_*
# into the client bundle), so it is passed as a build arg.
# ---------------------------------------------------------------------------

# ---- build stage ----------------------------------------------------------
FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY web/package.json web/package-lock.json* ./
RUN npm ci

COPY web/ ./

ARG NEXT_PUBLIC_BRIDGE_URL=ws://localhost:8080
ENV NEXT_PUBLIC_BRIDGE_URL=${NEXT_PUBLIC_BRIDGE_URL}
RUN npm run build

# ---- runtime stage --------------------------------------------------------
FROM node:22-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000

# Copy the built app and its production dependencies.
COPY --from=build /app/ ./

USER node
EXPOSE 3000
CMD ["npm", "run", "start"]
